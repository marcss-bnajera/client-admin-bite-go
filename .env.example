# ============================================================================
# Bite&Go Client (Admin) - Variables de entorno
# ============================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# Estas variables son públicas (VITE_*) y se empaquetan en el build.
# ============================================================================

# URL del auth-service (.NET) — para login
VITE_AUTH_URL=http://localhost:3000

# URL del admin-service (Node.js) — para gestión de restaurantes, pedidos, etc.
VITE_API_URL=http://localhost:3002/bite-and-go/v1
